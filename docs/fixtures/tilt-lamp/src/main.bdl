/// How far the lamp head is tilted from upright.
concept Tilt : Angle

/// The lamp's output level, 0 (off) to 1 (full).
concept Brightness : Scalar

clock interaction

/// The tilt sensor: a value per activation, from outside.
mapping tilt : Tilt @interaction

/// Upright is off, flat is full: brightness grows with the tilt.
mapping dimByTilt : Tilt -> Brightness
dimByTilt(Tilt) =
  Tilt / 90 deg

/// What the lamp shows: the rule applied to the sensor.
mapping brightness : Brightness @interaction
brightness() =
  dimByTilt(tilt)

/// The lamp itself.
output light : Brightness @interaction

drive light = brightness

device pwmLight : pwm_channel for light
