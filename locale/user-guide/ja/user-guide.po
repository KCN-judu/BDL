#: docs/user-guide/textual/editor-and-lsp.md:50
msgid "**Go to definition**"
msgstr ""

#: docs/user-guide/textual/editor-and-lsp.md:50
msgid "`textDocument/definition`"
msgstr ""

#: docs/user-guide/textual/editor-and-lsp.md:50
